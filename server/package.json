{
  "name": "luna-server",
  "version": "0.1.0",
  "private": true,
  "description": "Luna Family: Agora Conversational AI custom LLM, phone tool bridge and family hub",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=../.env --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --env-file-if-exists=../.env --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/index.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "agora-token": "^2.0.7",
    "baileys": "7.0.0-rc14",
    "express": "^5.3.0",
    "openai": "^7.59.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  }
}
