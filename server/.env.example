# Copy to .env and fill in. `npm start` reads it; on Railway or Render set the same names.

PORT=8080
# The https address Agora reaches this server at (no trailing slash): on a laptop, a tunnel's.
# Empty: everything but calls works (Agora needs a public URL for the LLM).
PUBLIC_URL=
# Every phone request carries it as X-App-Key; also ?key= on /whatsapp/qr and the dashboard.
APP_KEY=change-me
# Agora sends it as the Bearer on /v1/chat/completions.
LLM_PROXY_SECRET=change-me-too
TIME_ZONE=Asia/Kolkata

# Agora Console: the project's App ID and App Certificate. The Customer ID and Secret (Developer
# Toolkit → RESTful API) are optional: without them the agent's own token signs the REST calls.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_ASR_VENDOR=ares
AGORA_ASR_LANGUAGE=en-IN
# Replaces the whole asr block when set, e.g. Sarvam for Hinglish:
# AGORA_ASR_JSON={"vendor":"sarvam","params":{"api_key":"…","language":"unknown"}}
AGORA_ASR_JSON=

# Gemini through Google's OpenAI-compatible endpoint. Any OpenAI-compatible model works here.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
# Check AI Studio for the current Flash model id.
LLM_MODEL=gemini-3.8-flash
# Answer, in turn, when LLM_MODEL is busy (503) or says nothing for 8 s, for the next 2 minutes.
# Comma-separated; "none": always wait for LLM_MODEL. Default with Gemini:
# gemini-3.5-flash-lite,gemini-flash-lite-latest.
LLM_FALLBACK_MODEL=
# "none" turns thinking off on 2.5 Flash; newer Flash models take "minimal" or "low". Empty: the
# model's default (slower to the first word).
LLM_REASONING_EFFORT=

# Murf Falcon, spoken by Agora (tts vendor "murf"). Voice ids: GET
# https://api.murf.ai/v1/speech/voices?model=falcon-2.1 with header api-key.
MURF_API_KEY=
MURF_VOICE=Anusha
MURF_LOCALE=en-IN
MURF_MODEL=FALCON
# Slower speech is easier to follow for an older listener: -50 to 50.
MURF_RATE=0
# The India host; empty uses Agora's default (global).
MURF_BASE_URL=wss://in.api.murf.ai/v1/speech/stream-input

# WhatsApp through Baileys: Luna sends from the number you link at /whatsapp/qr (WhatsApp →
# Linked devices → Link a device). The session is kept here; delete the folder to sign out.
# WHATSAPP=off runs without it.
WHATSAPP=on
WHATSAPP_AUTH_DIR=data/whatsapp-auth

DB_PATH=data/hub.db
# The family, with their WhatsApp numbers. seed/family.json has none: copy it to
# seed/family.local.json (kept out of git) and fill them in; that copy is used when it exists.
SEED_PATH=
